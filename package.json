{
  "name": "proof-gatekeeper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "dev": "node --import tsx --env-file-if-exists=.env src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "replay": "node --import tsx scripts/replay.ts",
    "artifacts:check": "node --import tsx scripts/check-artifacts.ts"
  },
  "dependencies": {
    "snarkjs": "0.7.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": { "underscore": "1.13.8" }
}
