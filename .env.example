PORT=3000
HOST=0.0.0.0
AGENT_PATH=/agent
STATE_PATH=./data/state.sqlite
# Optional native TLS; otherwise terminate HTTPS at the hosting proxy.
TLS_CERT_PATH=
TLS_KEY_PATH=
